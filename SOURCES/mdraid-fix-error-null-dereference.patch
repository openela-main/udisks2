From 74649507f4731bd21ec5a402823b5b9748101ae2 Mon Sep 17 00:00:00 2001
From: Vojtech Trefny <vtrefny@redhat.com>
Date: Fri, 11 Sep 2026 10:15:42 +0200
Subject: [PATCH] udiskslinuxmdraid: Do not call bd_md_get_bitmap_location
 without error

Overlooked when backporting from 2.10 which uses libblockdev 3.x
which allows passing NULL for errors.
---
 src/udiskslinuxmdraid.c | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/src/udiskslinuxmdraid.c b/src/udiskslinuxmdraid.c
index 74ab9030..951951a5 100644
--- a/src/udiskslinuxmdraid.c
+++ b/src/udiskslinuxmdraid.c
@@ -319,7 +319,14 @@ udisks_linux_mdraid_update (UDisksLinuxMDRaid       *mdraid,
           sync_completed = read_sysfs_attr (raid_device->udev_device, "md/sync_completed");
           devfile = g_udev_device_get_device_file (raid_device->udev_device);
           if (devfile)
-            bitmap_location = bd_md_get_bitmap_location (devfile, NULL);
+            {
+              bitmap_location = bd_md_get_bitmap_location (devfile, &error);
+              if (bitmap_location == NULL && error != NULL)
+                {
+                  udisks_debug ("Failed to read array bitmap location: %s", error->message);
+                  g_clear_error (&error);
+                }
+            }
         }
 
       if (mdraid_has_stripes (level))
-- 
2.55.0

